{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "deny",
      "src/**": "allow",
      "tests/**": "allow",
      "docs/**": "allow",
      "spec/**": "allow",
      "schemas/**": "allow",
      "scripts/**": "allow",
      "profiles/**": "allow",
      "examples/**": "allow",
      ".github/**": "allow",
      ".opencode/**": "allow",
      "README.md": "allow",
      "AGENTS.md": "allow",
      "CONTRIBUTING.md": "allow",
      "SECURITY.md": "allow",
      "CHANGELOG.md": "allow",
      "NOTICE.md": "allow",
      "LICENSE": "allow",
      "CITATION.cff": "allow",
      "pyproject.toml": "allow",
      "uv.lock": "allow",
      "opencode.jsonc": "allow",
      ".gitignore": "allow",
      ".geminiignore": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "credentials.json": "deny",
      "*credentials*": "deny",
      "*.secret": "deny",
      "*.token": "deny",
      "id_rsa*": "deny",
      "id_ed25519*": "deny",
      "id_ecdsa*": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git diff --check": "allow",
      "git diff --stat": "allow",
      "git diff --cached --check": "allow",
      "git diff --cached --stat": "allow",
      "uv lock --check": "allow",
      "git push*": "ask",
      "gh repo create*": "ask"
    }
  }
}
