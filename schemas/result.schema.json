{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weby-homelab/llm-weissman-index/blob/main/schemas/result.schema.json",
  "title": "LWI Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "schema_version", "status", "candidate", "baseline", "profile", "comparison_context_id", "result_digest"],
  "properties": {
    "spec_version": {"const": "0.1"}, "schema_version": {"const": "1"},
    "status": {"enum": ["eligible", "ineligible", "incomplete", "invalid"]}, "reason": {"type": ["string", "null"]},
    "candidate": {"type": "object", "required": ["id", "revision"]}, "baseline": {"type": "object", "required": ["id", "revision"]},
    "profile": {"type": "object", "required": ["id", "version", "digest"]}, "comparison_context_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lwi": {"type": ["string", "null"]}, "quality": {"type": ["object", "null"]}, "resource_ratios": {"type": "object"}, "raw_metrics": {"type": "object"}, "quality_gate": {"type": "object"},
    "contributions": {"type": "object", "additionalProperties": {"type": "object", "required": ["ratio", "weight", "log_contribution"], "properties": {"ratio": {"type": ["string", "null"]}, "weight": {"type": ["string", "null"]}, "log_contribution": {"type": ["string", "null"]}}, "additionalProperties": false}}, "log_contribution_sum": {"type": ["string", "null"]}, "uncertainty_status": {"enum": ["available", "unavailable"]},
    "warnings": {"type": "array", "items": {"type": "object"}}, "errors": {"type": "array", "items": {"type": "object"}}, "measurement_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "measurement_digest_semantics": {"const": "normalized_public_record_v1"}, "raw_artifact_integrity": {"type": "object", "required": ["candidate", "baseline"], "properties": {"candidate": {"const": "unavailable"}, "baseline": {"const": "unavailable"}}, "additionalProperties": false}, "pareto_dominated": {"type": ["boolean", "null"]},
    "workload": {"type": "object"}, "protocol": {"type": "object"}, "measurement_environment": {"type": "object"}, "profile_policy": {"type": "object"}, "provenance": {"type": "object"}, "raw_quality": {"type": "object"}, "parameter_metadata": {"type": "object"}, "model_artifacts": {"type": "object"}, "quality_contexts": {"type": "object"}, "execution_systems": {"type": "object"}, "operating_envelopes": {"type": "object"},
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "eligible"}}, "required": ["status"]},
      "then": {"required": ["lwi"], "properties": {"lwi": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"}}}
    }
  ]
}
