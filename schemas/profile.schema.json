{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weby-homelab/llm-weissman-index/blob/main/schemas/profile.schema.json",
  "title": "LWI Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version", "profile_id", "version", "intended_use", "policy_statement",
    "weights", "quality", "metrics", "quality_gate", "environment_comparison_keys",
    "valid_workload_assumptions", "known_correlations", "known_exclusions", "mode"
  ],
  "properties": {
    "spec_version": {"const": "0.1"},
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "intended_use": {"type": "string", "minLength": 1},
    "policy_statement": {"type": "string", "minLength": 1},
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "metrics"],
      "properties": {"quality": {"type": "string"}, "metrics": {"type": "object", "additionalProperties": {"type": "string"}}}
    },
    "quality": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "weight", "raw_direction", "scale_type", "raw_unit", "valid_range", "utility_transform", "utility_transform_version", "utility_floor", "utility_ceiling", "source"],
        "properties": {
          "metric_id": {"type": "string"}, "weight": {"type": "string"}, "raw_direction": {"enum": ["higher_is_better", "lower_is_better"]},
          "scale_type": {"type": "string"}, "raw_unit": {"type": "string"}, "valid_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "utility_transform": {"type": "string"}, "utility_transform_version": {"type": "string"}, "utility_floor": {"type": "string"}, "utility_ceiling": {"type": "string"}, "source": {"type": "string"}
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "weight", "direction", "dimension", "canonical_unit", "statistic", "source"],
        "properties": {
          "metric_id": {"type": "string"}, "weight": {"type": "string"}, "direction": {"enum": ["higher_is_better", "lower_is_better"]},
          "dimension": {"type": "string"}, "canonical_unit": {"type": "string"}, "statistic": {"type": "string"}, "source": {"type": "string"}, "parameter_semantics": {"type": "string"}
        }
      }
    },
    "quality_gate": {"type": "object", "additionalProperties": false, "required": ["minimum_retention"], "properties": {"minimum_retention": {"type": "string"}}},
    "environment_comparison_keys": {"type": "array", "items": {"type": "string"}},
    "valid_workload_assumptions": {"type": "array", "items": {"type": "string"}},
    "known_correlations": {"type": "array", "items": {"type": "string"}},
    "known_exclusions": {"type": "array", "items": {"type": "string"}},
    "mode": {"enum": ["parameter", "edge", "api"]}
  }
}
